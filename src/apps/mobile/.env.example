# Copy to .env. EXPO_PUBLIC_* values are inlined into the JS bundle at build
# time and are visible in the shipped app -- never put a secret here.
#
# Use your computer's LAN IP, not localhost: the phone resolves localhost to
# itself. Find it with `ipconfig` (Windows) or `ifconfig | grep inet` (macOS).
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
